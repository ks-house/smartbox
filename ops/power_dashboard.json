{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "Existing SmartBox InfluxDB",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "uid": "smartbox-power",
  "title": "SmartBox 배터리·전원 감시",
  "description": "전압·보호·측정 유효성·수신 간격. 전류는 모터 분기이며 SOC/전체 소비량을 뜻하지 않습니다.",
  "tags": [
    "smartbox",
    "power"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-48h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "smartbox_bucket",
        "type": "constant",
        "label": "SmartBox bucket",
        "query": "smartbox",
        "current": {
          "text": "smartbox",
          "value": "smartbox"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "배터리 전압 — 측정 지점 기준",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${smartbox_bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r.topic == \"smartbox/telemetry\" and r._field == \"battery_v\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "전원 보호 단계 0정상·1경고·2절전·3보호·4회복·5측정오류",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${smartbox_bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r.topic == \"smartbox/telemetry\" and r._field == \"power_state_code\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "전압 측정 유효성 1유효·0불명",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${smartbox_bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r.topic == \"smartbox/telemetry\" and r._field == \"power_sensor_valid\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "회복까지 남은 시간",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${smartbox_bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r.topic == \"smartbox/telemetry\" and r._field == \"power_recovery_remaining_s\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "자료 수신 간격 — 마지막 수신은 현재 전압이 아님",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${smartbox_bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r.topic == \"smartbox/telemetry\" and r._field == \"power_report_interval_s\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "모터 분기 전류 — 전체 배터리 소비량 아님",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mamp"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${smartbox_bucket}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r.topic == \"smartbox/telemetry\" and r._field == \"motor_current_ma\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: true)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
